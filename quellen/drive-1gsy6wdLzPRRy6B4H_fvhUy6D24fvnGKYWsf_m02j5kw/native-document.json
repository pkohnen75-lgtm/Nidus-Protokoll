            "paragraph": {
              "elements": [
                {
                  "startIndex": 3079,
                  "endIndex": 3150,
                  "textRun": {
                    "content": "- Darstellung des eigenen Entwicklungswegs und der eigenen Wertebasis,\n",
                    "textStyle": {}
                  }
                }
              ],
              "paragraphStyle": {
                "namedStyleType": "NORMAL_TEXT",
