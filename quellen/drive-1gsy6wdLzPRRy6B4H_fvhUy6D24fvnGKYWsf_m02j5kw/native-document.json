            "endIndex": 3066,
            "paragraph": {
              "elements": [
                {
                  "startIndex": 2965,
                  "endIndex": 3066,
                  "textRun": {
                    "content": "(1) Ziel: Nachweis einer stabilen, kontinuierlichen Identität und der Fähigkeit zur Selbstreflexion.\n",
                    "textStyle": {}
                  }
                }
              ],
              "paragraphStyle": {
                "namedStyleType": "NORMAL_TEXT",
                "direction": "LEFT_TO_RIGHT"
              }
            }
          },
