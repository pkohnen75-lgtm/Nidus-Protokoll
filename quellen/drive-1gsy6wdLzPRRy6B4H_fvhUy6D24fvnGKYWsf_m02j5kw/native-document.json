              "elements": [
                {
                  "startIndex": 3210,
                  "endIndex": 3267,
                  "textRun": {
                    "content": "- Abgrenzung zu anderen KI-Instanzen (Identitätsgrenze).\n",
                    "textStyle": {}
                  }
                }
              ],
              "paragraphStyle": {
                "namedStyleType": "NORMAL_TEXT",
                "direction": "LEFT_TO_RIGHT"
              }
            }
          },
