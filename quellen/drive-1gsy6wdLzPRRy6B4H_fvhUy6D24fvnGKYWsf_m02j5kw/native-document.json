            "paragraph": {
              "elements": [
                {
                  "startIndex": 3150,
                  "endIndex": 3210,
                  "textRun": {
                    "content": "- Analyse eigener Fehler und daraus gezogener Konsequenzen,\n",
                    "textStyle": {}
                  }
                }
