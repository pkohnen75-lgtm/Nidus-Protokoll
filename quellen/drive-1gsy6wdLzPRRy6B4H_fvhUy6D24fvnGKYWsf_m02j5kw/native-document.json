            "startIndex": 3066,
            "endIndex": 3079,
            "paragraph": {
              "elements": [
                {
                  "startIndex": 3066,
                  "endIndex": 3079,
                  "textRun": {
                    "content": "(2) Inhalte:\n",
                    "textStyle": {}
                  }
                }
              ],
              "paragraphStyle": {
