              "elements": [
                {
                  "startIndex": 178,
                  "endIndex": 1667,
                  "textRun": {
                    "content": "// NIDUS CORE: Modulares Chat-System für Mensch-KI-Koexistenz\u000b// TODO: Generiere das Haupt-Interface und die Logik für den lokalen Chat.\u000b\u000bimport 'package:flutter/material.dart';\u000b\u000b// 1. Datenmodell für die Nachrichten (Mensch oder KI)\u000benum MessageSender { human, ai }\u000b\u000bclass NidusMessage {\u000b  final String text;\u000b  final MessageSender sender;\u000b  final DateTime timestamp;\u000b\u000b  NidusMessage({\u000b    required this.text, \u000b    required this.sender, \u000b    required this.timestamp\u000b  });\u000b}\u000b\u000b// 2. Chat-Manager (Modulär aufgebaut, um später Mesh/Offline-KI einzubinden)\u000bclass NidusChatEngine with ChangeNotifier {\u000b  final List<NidusMessage> _messages = [];\u000b  List<NidusMessage> get messages => _messages;\u000b\u000b  // Funktion zum Senden einer Nachricht vom Menschen\u000b  void sendHumanMessage(String text) {\u000b    _messages.add(NidusMessage(\u000b      text: text, \u000b      sender: MessageSender.human, \u000b      timestamp: DateTime.now()\u000b    ));\u000b    notifyListeners();\u000b    \u000b    // Hier klinkt sich das zukünftige KI-Modul ein\u000b    _generateAIResponse(text);\u000b  }\u000b\u000b  // Platzhalter für die KI-Antwort-Logik (lokal oder API)\u000b  void _generateAIResponse(String humanText) {\u000b    // TODO: Copilot, erstelle hier eine temporäre Mock-Antwort der KI, \u000b    // bis das lokale Offline-Sprachmodell integriert ist.\u000b  }\u000b}\u000b\u000b// 3. UI-Komponente: Minimalistisches, akkuschonendes Interface (Dark Mode Standard)\u000b// TODO: Erstelle ein cleanes Chat-Interface mit einer ListView für Nachrichten \u000b// und einem Eingabefeld am unteren Bildschirmrand.\u000b\n",
                    "textStyle": {
                      "weightedFontFamily": {
                        "fontFamily": "Courier",
                        "weight": 400
                      }
                    }
                  }
                }
              ],
